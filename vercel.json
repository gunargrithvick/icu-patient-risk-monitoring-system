{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "python -m pip install -r requirements-vercel.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,data/**,artifacts/**,build/**,dist/**,.pytest_cache/**,.ruff_cache/**,**/__pycache__/**,**/*.pyc,app.py,Dockerfile,docker-compose.yml,Makefile,.streamlit/**}"
    }
  }
}
